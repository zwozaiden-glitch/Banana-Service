# Banana Service — example environment variables
# Never put live credentials in this file or commit a real .env.

# Required for the bot. Replace locally or set in your hosting provider's Variables.
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_id_here

# Optional: test-server command registration (leave blank for global commands).
DEV_GUILD_ID=

# Branding
DEFAULT_EMBED_COLOR=#FFE135
BOT_STATUS_TEXT=🍌 Serving Banana Scripts | /help
BOT_STATUS_TYPE=Watching

# Storage. On Railway, mount a persistent Volume at /data and set DATA_DIR=/data.
DATA_DIR=./data
# Optional individual overrides; leave blank to keep all data under DATA_DIR.
DATABASE_PATH=
STORAGE_DIR=
TRANSCRIPTS_DIR=
BACKUPS_DIR=
MAX_SCRIPT_SIZE_MB=8

# YouTube public RSS polling; no API key is required.
YOUTUBE_CHECK_INTERVAL_SECONDS=180

# Optional translation configuration.
TRANSLATION_API_URL=https://libretranslate.com/translate
TRANSLATION_API_KEY=

LOG_LEVEL=info
