# ==========================================
# Banana Service - Discord Bot Configuration
# ==========================================

# Discord Bot Credentials (Required)
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here

# Optional: Guild ID for instant local slash command deployment (leave blank for global)
DEV_GUILD_ID=

# Bot Appearance & Branding
DEFAULT_EMBED_COLOR=#FFE135
BOT_STATUS_TEXT=🍌 Serving Banana Scripts | /help
BOT_STATUS_TYPE=Watching

# Storage and Database Settings
# DATA_DIR is the single root for ALL writable state (database, scripts,
# transcripts, backups). On ephemeral hosts (Railway, Render, Fly) point this
# at a mounted volume, e.g. DATA_DIR=/data, or everything is lost on redeploy.
DATA_DIR=./data
DATABASE_PATH=./data/banana_service.db
STORAGE_DIR=./data/scripts
TRANSCRIPTS_DIR=./data/transcripts
BACKUPS_DIR=./data/backups
MAX_SCRIPT_SIZE_MB=8

# YouTube Notification Poller Settings
# Note: Banana Service will monitor YouTube channels via public XML feeds automatically.
# You can optionally provide a YouTube Data API v3 key for higher quota and additional channel metadata.
YOUTUBE_CHECK_INTERVAL_SECONDS=180
YOUTUBE_API_KEY=

# Translation Settings
# Leave blank to use Banana Service's built-in multi-engine translation fallback (LibreTranslate/Google)
TRANSLATION_API_URL=https://libretranslate.com/translate
TRANSLATION_API_KEY=

# Logging level: debug, info, warn, error
LOG_LEVEL=info
